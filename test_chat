import requests

SERVER_URL = 'http://127.0.0.1:5000/chat'

def test_server():
    test_message = "γεια σου ρομπότ, πώς είσαι;"
    payload = {'text': test_message}

    print(f"Αποστολή στον Server: '{test_message}'")

    try:
        response = requests.post(SERVER_URL, json=payload, timeout=15)

        if response.status_code == 200:
            data = response.json()
            print(f"Απάντηση από Server: {data.get('response')}")
        else:
            print(f"Σφάλμα Server, Status Code: {response.status_code}")
            print(response.text)
    except Exception as e:
        print(f"Αποτυχία σύνδεσης: {e}")

if __name__ == '__main__':
    test_server()
