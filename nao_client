def record_audio(soundRecordPath, localPath):
    if audio_recorder:
        audio_recorder.startMicrophonesRecording(soundRecordPath, "wav", 16000, (0, 0, 1, 0))
        time.sleep(5)
        audio_recorder.stopMicrophonesRecording()

        ssh_client = paramiko.SSHClient()
        ssh_client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        ssh_client.connect(hostname=IP, port=22, username='nao', password='nao')
        ftp_client = ssh_client.open_sftp()
        ftp_client.get(soundRecordPath, localPath)
        ftp_client.close()
        ssh_client.close()
    else:
        print("[Mock Mode] Ηχογράφηση προσομοίωσης...")
        time.sleep(2)

    print("Audio recorded successfully.")

def run_script(script_path, txt_path):
    conda_environment_name = 'test'

    try:
        subprocess.check_call(['conda', 'run', '-n', conda_environment_name, 'python', script_path])
        print("Subprocess completed successfully.")
    except subprocess.CalledProcessError as e:
        print('Error in subprocess execution:', e)

    try:
        with open(txt_path, 'r', encoding='utf-8') as file:
            lines = file.readlines()
            concatenated_text = ' '.join(lines).replace('\n', '').strip().lower()
    except Exception as e:
        print(f"Error reading text file: {e}")
        concatenated_text = ""

    print(f"Normalized Text: '{concatenated_text}'")
    return concatenated_text

def ask_gemini_server(user_text):
    """Στέλνει το κείμενο στον Flask server και επιστρέφει την απάντηση του Gemini"""
    try:
        payload = {'text': user_text}
        response = requests.post(SERVER_URL, json=payload, timeout=15)

        if response.status_code == 200:
            data = response.json()
            return data.get('response', 'Προέκυψε σφάλμα στη λήψη της απάντησης.')
        else:
            print(f"Server Error Status: {response.status_code}")
            return "Συγγνώμη, υπήρξε σφάλμα στον διακομιστή."
    except Exception as e:
        print(f"Connection error to server: {str(e)}")
        return "Δεν ήταν δυνατή η σύνδεση με τον διακομιστή."


